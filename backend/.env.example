# ==============================================================================
# AI-Driven Multi-Environmental Personalized Pedestrian Routing
# Backend Environment Configuration
# ==============================================================================

# Server configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Routing Service (OpenRouteService)
# Obtain your free API key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_api_key_here

# Open-Meteo Weather & Air Quality APIs do not require API keys for standard free tiers:
# - Weather Forecast API: https://api.open-meteo.com/v1/forecast
# - Air Quality API: https://air-quality-api.open-meteo.com/v1/air-quality

# Overpass API (OpenStreetMap greenery features):
# Standard public endpoints, e.g. https://overpass-api.de/api/interpreter
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Geocoding Service (OpenStreetMap Nominatim)
# Follows Nominatim usage policy (custom User-Agent & rate limits)
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=EcoWalk-PedestrianRouting/1.0 (academic-pedestrian-routing)

# Open-Meteo Environmental Endpoints & Caching
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
ENVIRONMENT_CACHE_TTL_SECONDS=900
